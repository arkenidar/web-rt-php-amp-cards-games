{
    "name": "arkenidar/web-rt-cards-game-php-amp",
    "description": "Multiplayer real-time card game platform (lobby + 2-player duels) built on the Amp WebSocket server",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "amphp/websocket-server": "^4.0",
        "amphp/http-server-router": "^2.0",
        "amphp/http-server-static-content": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "DuelGame\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DuelGame\\Test\\": "test/"
        }
    },
    "require-dev": {
        "amphp/websocket-client": "^2.0"
    }
}
